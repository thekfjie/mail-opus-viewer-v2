[Unit]
Description=Opus Mail Viewer V2 API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/mail-opus-viewer-v2
Environment=NODE_ENV=production
Environment=PROJECT_ROOT=/opt/mail-opus-viewer-v2
UMask=0077
StateDirectory=mail-opus-v2
StateDirectoryMode=0700
ExecStartPre=/usr/local/bin/node /opt/mail-opus-viewer-v2/scripts/verify-build.mjs
ExecStart=/usr/local/bin/node /opt/mail-opus-viewer-v2/dist/server/server/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mail-opus-v2 /var/backups/mail-opus-v2

[Install]
WantedBy=multi-user.target
