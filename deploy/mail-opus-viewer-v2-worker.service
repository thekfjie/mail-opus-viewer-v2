[Unit]
Description=Opus Mail Viewer V2 Sync Worker
After=network-online.target mail-opus-viewer-v2.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/mail-opus-viewer-v2
Environment=NODE_ENV=production
Environment=PROJECT_ROOT=/opt/mail-opus-viewer-v2
UMask=0077
StateDirectory=mail-opus-v2
StateDirectoryMode=0700
ExecStart=/usr/local/bin/node /opt/mail-opus-viewer-v2/dist/server/server/worker.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mail-opus-v2 /var/backups/mail-opus-v2

[Install]
WantedBy=multi-user.target
