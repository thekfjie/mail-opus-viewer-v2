{
  "name": "mail-opus-viewer-v2",
  "version": "0.1.0",
  "description": "Administrative console for account lifecycle, credential, and mailbox operations",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean-build.mjs",
    "build": "npm run clean && npm run build:server && npm run build:web && node scripts/write-build-manifest.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "dev": "tsx watch src/server/server.ts",
    "start": "node dist/server/server/server.js",
    "worker": "node dist/server/server/worker.js",
    "backup": "node dist/server/server/backup.js",
    "migrate:v1": "tsx src/server/migrate-v1.ts",
    "audit": "tsx scripts/audit-production.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@types/mailparser": "^3.4.6",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.5.0",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.9.20",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
