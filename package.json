{
  "name": "mail-opus-viewer-v2",
  "version": "0.1.0",
  "description": "Administrative console for account lifecycle, credential, and mailbox operations",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean-build.mjs",
    "build": "npm run clean && npm run build:server && npm run build:web && node scripts/write-build-manifest.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "dev": "tsx watch src/server/server.ts",
    "start": "node dist/server/server/server.js",
    "worker": "node dist/server/server/worker.js",
    "backup": "node dist/server/server/backup.js",
    "migrate:v1": "tsx src/server/migrate-v1.ts",
    "audit": "tsx scripts/audit-production.ts",
    "test": "OPUS_SQLITE_TEST=1 ENV_FILE=/dev/null node --import tsx --test --test-concurrency=4 tests/*.test.ts",
    "test:offline": "node scripts/test-offline.mjs",
    "validate:mailbox-batch-copy": "tsx scripts/validate-mailbox-batch-copy.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc --noEmit",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts && node --import tsx scripts/test-mysql-contracts.ts",
    "db:migrate": "node --import tsx src/server/storage/migrate.ts",
    "db:import-sqlite": "node --import tsx src/server/storage/import-sqlite.ts",
    "backup:sqlite-legacy": "node --import tsx src/server/storage/backup-legacy-sqlite.ts",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:fixture": "node --import tsx scripts/benchmark-fixture.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@types/mailparser": "^3.4.6",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.12.7",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.9.46",
    "mysql2": "^3.24.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.3.7"
  }
}
