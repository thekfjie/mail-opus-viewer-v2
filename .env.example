PORT=8790
DATABASE_PATH=.state/mail-opus-v2.sqlite
# API 和 Worker 竞争 SQLite 写锁时等待前一事务完成。
V2_SQLITE_BUSY_TIMEOUT_MS=30000
V2_READ_ONLY=false
V2_ACCOUNT_AUTHORITY=v2
V2_SYNC_INTERVAL_MS=60000
# 共享邮件 API 默认不轮询，避免 V1/V2 共存时重复消耗上游/CF 配额。
V2_SHARED_MAIL_SYNC_ENABLED=false
V2_SHARED_MAIL_SYNC_INTERVAL_MS=600000
V2_SHARED_MAIL_PAGE_SIZE=100
V2_SHARED_MAIL_MAX_PAGES=1
V2_OUTLOOK_MAIL_SYNC_ENABLED=false
V2_OUTLOOK_MAIL_SYNC_BATCH=20
V2_OUTLOOK_SYNC_INTERVAL_MS=300000
V2_AUTO_TRIAL_ENABLED=false
# 新 AT 首次发现后等待 12 小时，再由 Worker 自动执行一次 JP 优惠检测。
V2_AUTO_TRIAL_DELAY_MS=43200000
V2_AUTO_TRIAL_RETRY_MS=21600000
V2_AUTO_TRIAL_BATCH_SIZE=10
PUBLIC_ORIGIN=https://mail.example.com
SESSION_SECRET=
V2_SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
VIEWER_ADMIN_PASSWORD=
IMPORT_API_KEY=
MAIL_API_BASE=
MAIL_ADMIN_AUTH=
# Cloudflare 邮件索引补漏默认关闭；只有显式配置只读凭据和索引后才可使用。
V2_CF_ACCOUNT_ID=
V2_CF_D1_DATABASE_ID=
V2_CF_D1_READ_TOKEN=
V2_CF_D1_TIME_INDEX=
V2_MAIL_WEBHOOK_SECRET=
V2_PENDING_MAIL_BATCH_SIZE=20
V2_PENDING_MAIL_INTERVAL_MS=60000
V2_PENDING_MAIL_RETRY_DELAY_MS=300000
V2_OAUTH_PROBE_PYTHON=python3
V2_OAUTH_PROBE_FILE=
V2_OAUTH_HEALTH_PROXY=
V2_OAUTH_ME_URL=https://chatgpt.com/backend-api/me
V2_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
PROMOTION_PYTHON=python3
PROMOTION_BRIDGE=scripts/promo-check-bridge.py
PROMOTION_TIMEOUT_MS=120000
V2_PROMOTION_CONCURRENCY=4
OUTLOOK_MANAGER_BASE=
OUTLOOK_MANAGER_PASSWORD=
SUB2API_API_URL=
SUB2API_ADMIN_EMAIL=
SUB2API_ADMIN_PASSWORD=
SUB2API_ADMIN_TOKEN=
# Separate key for AutoMyAI's sanitized payment-exposure observation ingest.
PAYMENT_EXPOSURE_API_KEY=
# 支付资格为纯 API 检查：一次 POST，不创建 Checkout，不访问 Stripe 支付流程。
# 管理员也可在 V2 后台长期覆盖地址/令牌；覆盖值加密保存在数据库。
PAYMENT_ELIGIBILITY_API_URL=
PAYMENT_ELIGIBILITY_API_TOKEN=
# 旧 AutoMyAI payment_exposure / Checkout 配置仅为兼容历史数据，不用于 V2 支付资格检测。
AUTOMYAI_EXTRACT_API_BASE=http://127.0.0.1:18794
AUTOMYAI_EXTRACT_API_KEY=
PAYMENT_METHOD_EXTRACT_API_BASE=http://127.0.0.1:18794
PAYMENT_METHOD_EXTRACT_API_KEY=
MOMO_ELIGIBILITY_EXTRACT_API_BASE=http://127.0.0.1:18794
PAYMENT_EXPOSURE_TIMEOUT_MS=120000
PAYMENT_EXPOSURE_PROXY_NL=
PAYMENT_EXPOSURE_PROXY_DE=
PAYMENT_EXPOSURE_PROXY_PH=
# 所有优惠资格检测固定使用这个 JP 出口。
PAYMENT_EXPOSURE_PROMOTION_PROXY_JP=
# Coupon fallback candidates. IDs returned dynamically by accounts/check and
# IDs previously observed in the database are added automatically.
V2_PROMOTION_CAMPAIGNS=plus-1-month-free,plus-2-months-50-pct-off,go-1-month-free,go-3-months-50-pct-off
PAYMENT_EXPOSURE_PROMO_CAMPAIGN_ID=plus-1-month-free
# Canonical Cloudflare Email Routing destination and historical aliases.
ROUTING_PRIMARY_EMAIL=relay@example.net
ROUTING_LEGACY_EMAILS=legacy-relay@example.net,archive-relay@example.net
# Additional routing endpoints (for example the edu subdomain destination).
ROUTING_EMAILS=relay@routing.example.net
# CREDENTIAL_ENCRYPTION_KEY=base64-or-long-random-secret
# 同一完整本地部分可自动识别为换绑的可信域。example.net 同时覆盖其子域。
TRUSTED_REBIND_DOMAINS=icloud.com,example.com,example.net
