# Application
PORT=8790
DATABASE_PATH=/var/lib/mail-opus-v2/mail-opus-v2.sqlite
PUBLIC_ORIGIN=http://127.0.0.1:8790
V2_READ_ONLY=true
V2_SYNC_INTERVAL_MS=60000
V2_AUTO_TRIAL_ENABLED=true
V2_AUTO_TRIAL_DELAY_MS=43200000
V2_AUTO_TRIAL_RETRY_MS=21600000
V2_AUTO_TRIAL_BATCH_SIZE=10
V2_AUTO_TRIAL_ROUTE=nl_ideal

# Required secrets
V2_SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
VIEWER_ADMIN_PASSWORD=

# Shared mail service
MAIL_API_BASE=http://127.0.0.1:8787
MAIL_ADMIN_AUTH=

# Outlook-compatible mail service
OUTLOOK_MANAGER_BASE=http://127.0.0.1:5010
OUTLOOK_MANAGER_PASSWORD=
OUTLOOK_MANAGER_ENV_FILE=

# External account platform
SUB2API_API_URL=http://127.0.0.1:8080/api/v1
SUB2API_ADMIN_EMAIL=
SUB2API_ADMIN_PASSWORD=
SUB2API_ADMIN_TOKEN=

# Payment exposure integration
PAYMENT_EXPOSURE_API_KEY=
AUTOMYAI_EXTRACT_API_BASE=http://127.0.0.1:18794
AUTOMYAI_EXTRACT_API_KEY=
PAYMENT_EXPOSURE_PROXY_NL=
PAYMENT_EXPOSURE_PROXY_DE=
PAYMENT_EXPOSURE_PROXY_PH=
PAYMENT_EXPOSURE_PROMOTION_PROXY_JP=
PAYMENT_EXPOSURE_PROMO_CAMPAIGN_ID=plus-1-month-free

# Association rules
ROUTING_PRIMARY_EMAIL=relay@example.com
ROUTING_LEGACY_EMAILS=legacy-relay@example.com
ROUTING_EMAILS=relay@example.com
TRUSTED_REBIND_DOMAINS=icloud.com,example.com

# Optional compatibility import
V1_ENV_FILE=
V1_CONFIG_FILE=
V1_MAIL_INDEX_FILE=
V1_BACKUPS_DIR=

# Verified backups
V2_BACKUP_DIRECTORY=/var/backups/mail-opus-v2
V2_BACKUP_RETENTION=45
